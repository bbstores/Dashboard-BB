# Pooled Neon connection string for the application runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Direct Neon connection string for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Lark app tự tạo, dùng cho /api/lark/approval-options (ô external options của phiếu Approval).
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_BASE_TOKEN=base_token_that
LARK_STAFF_TABLE_ID=tbl_2_16_nhan_su_ngoai
LARK_TASK_TABLE_ID=tbl_2_6_tasklist
# Chuỗi bí mật, điền giống hệt vào ô "Please enter token" của form Approval.
LARK_APPROVAL_OPTIONS_TOKEN=random_secret
